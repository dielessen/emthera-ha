{
 "format": "boiler-material 1",
 "minor": 1,
 "about": "The allow-list of the material bundle \"boiler-material 1\": what the Hub sends by itself, after one permission, and from which our own computer makes the report \"boiler-share 2\" with the builder that already exists. Every member: type, range or fixed words; a key that is not listed makes the whole bundle invalid (like the report's). A node {\"report\": path} is the node of the report's allow-list (allowlist.json) at that path: the Hub's OpenTherm documents are held to the very same limits as the report's members. Nothing in here carries a name, an address, a network name or a room.",
 "limits": {
  "bundle_bytes": 650000,
  "recording_bytes": 2097152,
  "document_bytes": 262144
 },
 "defs": {
  "date": {
   "t": "text",
   "pattern": "20[0-9]{2}-[01][0-9]-[0-3][0-9]"
  },
  "version": {
   "t": "text",
   "pattern": "[0-9A-Za-z][0-9A-Za-z.+_-]{0,31}"
  }
 },
